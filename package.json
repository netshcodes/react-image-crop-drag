{
  "name": "react-image-crop-drag",
  "version": "1.3.1",
  "description": "React component for a draggable, zoomable image crop view",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netshcodes/react-image-crop-drag.git"
  },
  "homepage": "https://github.com/netshcodes/react-image-crop-drag#readme",
  "bugs": {
    "url": "https://github.com/netshcodes/react-image-crop-drag/issues"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit --strict --target es2020 --moduleResolution node --esModuleInterop src/types.check.ts",
    "test": "node --test && npm run typecheck",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-react": "^7.22.15",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@types/react": "^18.2.0",
    "rollup": "^2.79.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react",
    "image",
    "crop",
    "drag",
    "poster"
  ],
  "author": "netshcodes",
  "contributors": [
    "netshcodes"
  ],
  "license": "MIT"
}
